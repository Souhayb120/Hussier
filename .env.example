# Copy to .env for local development (.env is not committed).
# npm run dev: Vite proxies /api to this backend.
MOFAWID_API=http://localhost:8080

# Optional, for builds: absolute backend URL called by the browser.
# Leave unset on Vercel: vercel.json forwards /api to the backend.
# VITE_API_URL=https://your-backend.example.com/api
